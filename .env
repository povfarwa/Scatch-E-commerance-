# JWT Secret Key (used for token generation and verification)
JWT_KEY=your_super_secret_jwt_key_change_this_in_production

# Express Session Secret
EXPRESS_SESSION_SECRET=your_express_session_secret_change_this

# Node Environment
NODE_ENV=development

# MongoDB URI (already in config/development.json, but can be overridden here)
# MONGODB_URI=mongodb://127.0.0.1:27017
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch - Join Us</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 font-sans">
    <div class="max-w-7xl mx-auto px-10 py-10">
        <h1 class="text-2xl font-semibold mb-20">Scatch</h1>

        <% if(error && error.length > 0){ %>
            <div class="mb-5 p-3 bg-red-100 text-red-600 rounded-lg text-center">
                <%= error %>
            </div>
        <% } %>

        <div class="flex justify-between gap-20">
            <div class="w-1/2">
                <h2 class="text-4xl font-bold mb-4">Welcome to <span class="text-blue-500">Scatch</span></h2>
                <p class="text-gray-600 text-lg leading-relaxed">Create your account to start shopping.</p>
            </div>

            <div class="w-1/3 bg-white p-8 rounded-xl shadow-sm border border-gray-100">
                <div id="signup-form">
                    <h3 class="text-2xl font-semibold mb-6">Create your account</h3>
                    <form action="/users/register" method="POST" class="space-y-4">
                        <input type="text" name="fullname" placeholder="Full Name" required class="w-full px-4 py-3 bg-gray-100 rounded-lg outline-none">
                        <input type="email" name="email" placeholder="Email" required class="w-full px-4 py-3 bg-gray-100 rounded-lg outline-none">
                        <input type="password" name="password" placeholder="Password" required class="w-full px-4 py-3 bg-gray-100 rounded-lg outline-none">
                        <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-full font-medium hover:bg-blue-700">Create Account</button>
                    </form>
                    <p class="mt-6 text-center text-sm text-gray-500">Already have an account? <button onclick="toggleForm()" class="text-blue-600 font-semibold underline">Login</button></p>
                </div>

                <div id="login-form" class="hidden">
                    <h3 class="text-2xl font-semibold mb-6">Login to Scatch</h3>
                    <form action="/users/login" method="POST" class="space-y-4">
                        <input type="email" name="email" placeholder="Email" required class="w-full px-4 py-3 bg-gray-100 rounded-lg outline-none">
                        <input type="password" name="password" placeholder="Password" required class="w-full px-4 py-3 bg-gray-100 rounded-lg outline-none">
                        <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-full font-medium hover:bg-blue-700">Login</button>
                    </form>
                    <p class="mt-6 text-center text-sm text-gray-500">Don't have an account? <button onclick="toggleForm()" class="text-blue-600 font-semibold underline">Create Account</button></p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleForm() {
            document.getElementById('signup-form').classList.toggle('hidden');
            document.getElementById('login-form').classList.toggle('hidden');
        }
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | Scatch</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        body { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
        .product-hover { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .product-hover:hover { transform: translateY(-8px); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15); }
        .add-to-cart-btn { transition: all 0.3s ease; }
        .product-card:hover .add-to-cart-btn { opacity: 1; transform: translateY(0); }
        @keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fadeIn { animation: fadeInDown 0.5s ease-out; }
        .img-zoom { transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
        .product-card:hover .img-zoom { transform: scale(1.08); }
    </style>
</head>
<body class="bg-zinc-50">

    <!-- Success Toast Notification -->
    <% if(success && success.length > 0){ %>
        <div class="fixed top-6 right-6 z-[999] animate-fadeIn">
            <div class="bg-emerald-500 text-white px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3 min-w-[300px]">
                <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
                    <i class="ri-checkbox-circle-fill text-2xl"></i>
                </div>
                <div>
                    <p class="font-semibold text-sm"><%= success %></p>
                    <p class="text-xs text-emerald-100 mt-0.5">Item added to your bag</p>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Top Navigation -->
    <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-lg border-b border-zinc-200/60 shadow-sm">
        <div class="max-w-[1800px] mx-auto px-8 lg:px-16">
            <div class="flex items-center justify-between h-20">
                <!-- Logo -->
                <a href="/shop" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 bg-black rounded-xl flex items-center justify-center group-hover:bg-zinc-800 transition">
                        <span class="text-white font-black text-lg">S</span>
                    </div>
                    <span class="text-2xl font-black tracking-tight">Scatch</span>
                </a>

                <!-- Navigation Links -->
                <div class="flex items-center gap-8">
                    <a href="/shop" class="text-sm font-semibold text-black border-b-2 border-black pb-1 transition">
                        Shop
                    </a>
                    <a href="/users/cart" class="relative text-sm font-semibold text-zinc-500 hover:text-black transition">
                        <span>Cart</span>
                        <% if(user && user.cart && user.cart.length > 0) { %>
                            <span class="absolute -top-2 -right-4 w-5 h-5 bg-black text-white text-[10px] font-bold rounded-full flex items-center justify-center">
                                <%= user.cart.length %>
                            </span>
                        <% } %>
                    </a>
                    <a href="/users/logout" class="px-6 py-2.5 bg-zinc-900 text-white text-sm font-semibold rounded-full hover:bg-zinc-800 transition">
                        Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content with Sidebar -->
    <div class="max-w-[1800px] mx-auto py-12">
        <div class="flex gap-8">
            
            <!-- Left Sidebar - Filters -->
            <aside class="w-72 flex-shrink-0 sticky top-32 self-start hidden lg:block">
                
                <!-- Filters Card -->
                <div class="bg-white rounded-3xl border border-zinc-200/60 p-6 mb-6">
                    <h3 class="text-lg font-bold mb-6">Filters</h3>
                    
                    <!-- Price Range -->
                    <div class="mb-8">
                        <h4 class="text-sm font-bold text-zinc-700 mb-4">Price Range</h4>
                        <div class="space-y-3">
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-zinc-300">
                                <span class="text-sm text-zinc-600 group-hover:text-black">Under ₹1,000</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-zinc-300">
                                <span class="text-sm text-zinc-600 group-hover:text-black">₹1,000 - ₹2,000</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-zinc-300">
                                <span class="text-sm text-zinc-600 group-hover:text-black">₹2,000 - ₹3,000</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-zinc-300">
                                <span class="text-sm text-zinc-600 group-hover:text-black">Above ₹3,000</span>
                            </label>
                        </div>
                    </div>

                    <!-- Color -->
                    <div class="mb-8">
                        <h4 class="text-sm font-bold text-zinc-700 mb-4">Color</h4>
                        <div class="grid grid-cols-5 gap-3">
                            <button class="w-10 h-10 rounded-full bg-black hover:ring-2 ring-offset-2 ring-black transition"></button>
                            <button class="w-10 h-10 rounded-full bg-brown-600 hover:ring-2 ring-offset-2 ring-brown-600 transition" style="background-color: #92400E;"></button>
                            <button class="w-10 h-10 rounded-full bg-blue-600 hover:ring-2 ring-offset-2 ring-blue-600 transition"></button>
                            <button class="w-10 h-10 rounded-full bg-red-600 hover:ring-2 ring-offset-2 ring-red-600 transition"></button>
                            <button class="w-10 h-10 rounded-full bg-green-600 hover:ring-2 ring-offset-2 ring-green-600 transition"></button>
                            <button class="w-10 h-10 rounded-full bg-pink-400 hover:ring-2 ring-offset-2 ring-pink-400 transition"></button>
                            <button class="w-10 h-10 rounded-full bg-yellow-400 hover:ring-2 ring-offset-2 ring-yellow-400 transition"></button>
                            <button class="w-10 h-10 rounded-full bg-gray-300 hover:ring-2 ring-offset-2 ring-gray-300 transition"></button>
                            <button class="w-10 h-10 rounded-full bg-white border-2 hover:ring-2 ring-offset-2 ring-zinc-300 transition"></button>
                            <button class="w-10 h-10 rounded-full bg-purple-600 hover:ring-2 ring-offset-2 ring-purple-600 transition"></button>
                        </div>
                    </div>

                    <!-- Discount -->
                    <div class="mb-8">
                        <h4 class="text-sm font-bold text-zinc-700 mb-4">Discount</h4>
                        <div class="space-y-3">
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-zinc-300">
                                <span class="text-sm text-zinc-600 group-hover:text-black">10% and above</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-zinc-300">
                                <span class="text-sm text-zinc-600 group-hover:text-black">20% and above</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-zinc-300">
                                <span class="text-sm text-zinc-600 group-hover:text-black">30% and above</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-zinc-300">
                                <span class="text-sm text-zinc-600 group-hover:text-black">50% and above</span>
                            </label>
                        </div>
                    </div>

                    <!-- Availability -->
                    <div>
                        <h4 class="text-sm font-bold text-zinc-700 mb-4">Availability</h4>
                        <div class="space-y-3">
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-zinc-300">
                                <span class="text-sm text-zinc-600 group-hover:text-black">In Stock</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-zinc-300">
                                <span class="text-sm text-zinc-600 group-hover:text-black">Out of Stock</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Clear Filters Button -->
                <button class="w-full py-3 bg-zinc-100 hover:bg-zinc-200 rounded-2xl text-sm font-semibold text-zinc-700 transition">
                    Clear All Filters
                </button>
            </aside>

            <!-- Main Products Section -->
            <main class="flex-1">
                
                <!-- Page Header -->
                <div class="mb-10">
                    <h1 class="text-4xl lg:text-5xl font-black tracking-tight mb-3">Discover Premium Bags</h1>
                    <p class="text-zinc-500 text-lg">Handcrafted excellence for your everyday journey</p>
                </div>

                <!-- Products Grid -->
                <% if(products.length === 0) { %>
                    <!-- Empty State -->
                    <div class="flex flex-col items-center justify-center py-32">
                        <div class="w-24 h-24 bg-zinc-100 rounded-full flex items-center justify-center mb-6">
                            <i class="ri-shopping-bag-3-line text-5xl text-zinc-300"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-zinc-800 mb-2">No Products Available</h3>
                        <p class="text-zinc-500 mb-8">Check back soon for amazing new arrivals!</p>
                        <a href="/" class="px-8 py-3 bg-black text-white font-semibold rounded-full hover:bg-zinc-800 transition">
                            Go Home
                        </a>
                    </div>
                <% } else { %>
                    <!-- Products Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                        <% products.forEach(function(product){ %>
                            <div class="product-card group">
                                <div class="product-hover bg-white rounded-3xl overflow-hidden border border-zinc-200/60">
                                    
                                    <!-- Product Image Section -->
                                    <div class="relative aspect-[3/4] overflow-hidden"
                                         style="background-color: <%= product.bgcolor || '#F5F5F5' %>">
                                        
                                        <% if(product.image) { %>
                                            <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" 
                                                 alt="<%= product.name %>"
                                                 class="img-zoom w-full h-full object-cover">
                                        <% } else { %>
                                            <div class="w-full h-full flex items-center justify-center">
                                                <i class="ri-image-line text-7xl text-zinc-300"></i>
                                            </div>
                                        <% } %>

                                        <!-- Discount Badge -->
                                        <% if(product.discount > 0) { %>
                                            <div class="absolute top-4 right-4 px-3 py-1.5 bg-red-500 text-white text-xs font-bold rounded-full shadow-lg">
                                                <%= Math.round((product.discount / product.price) * 100) %>% OFF
                                            </div>
                                        <% } %>

                                        <!-- Quick Add Button -->
                                        <div class="absolute inset-x-0 bottom-0 p-4">
                                            <a href="/users/cart/<%= product._id %>" 
                                               class="add-to-cart-btn block w-full py-3.5 bg-white/95 backdrop-blur-sm text-center text-sm font-bold rounded-2xl shadow-xl opacity-0 transform translate-y-4 hover:bg-black hover:text-white transition">
                                                Add to Cart
                                            </a>
                                        </div>
                                    </div>

                                    <!-- Product Info Panel -->
                                    <div class="p-5" 
                                         style="background-color: <%= product.panelcolor || '#FFFFFF' %>; color: <%= product.textcolor || '#000000' %>">
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="flex-1 min-w-0">
                                                <h3 class="font-bold text-base leading-tight truncate mb-1">
                                                    <%= product.name %>
                                                </h3>
                                                <p class="text-xs opacity-60 font-medium">Premium Collection</p>
                                            </div>
                                            
                                            <div class="text-right flex-shrink-0">
                                                <% if(product.discount > 0) { %>
                                                    <p class="font-black text-lg leading-none">₹<%= product.price - product.discount %></p>
                                                    <p class="text-xs line-through opacity-50 mt-0.5">₹<%= product.price %></p>
                                                <% } else { %>
                                                    <p class="font-black text-lg">₹<%= product.price %></p>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>

                <!-- Products Count -->
                <% if(products.length > 0) { %>
                    <div class="mt-16 text-center">
                        <p class="text-zinc-500 text-sm">
                            Showing <span class="font-semibold text-zinc-900"><%= products.length %></span> 
                            <%= products.length === 1 ? 'product' : 'products' %>
                        </p>
                    </div>
                <% } %>

            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t border-zinc-200 mt-24">
        <div class="max-w-[1800px] mx-auto px-8 lg:px-16 py-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <p class="text-zinc-500 text-sm">© 2026 Scatch. Crafted with care.</p>
                <div class="flex items-center gap-6">
                    <a href="#" class="text-zinc-400 hover:text-zinc-700 transition">
                        <i class="ri-instagram-line text-xl"></i>
                    </a>
                    <a href="#" class="text-zinc-400 hover:text-zinc-700 transition">
                        <i class="ri-twitter-x-line text-xl"></i>
                    </a>
                    <a href="#" class="text-zinc-400 hover:text-zinc-700 transition">
                        <i class="ri-facebook-circle-line text-xl"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Auto-dismiss notification -->
    <script>
        setTimeout(() => {
            const toast = document.querySelector('.animate-fadeIn');
            if(toast) {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(400px)';
                setTimeout(() => toast.remove(), 300);
            }
        }, 4000);
    </script>

</body>
</html>